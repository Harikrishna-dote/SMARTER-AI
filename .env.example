# --- Configuration ---
APP_NAME=SMARTER AI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./future.db

# --- Security (REQUIRED: CHANGE THESE) ---
# MUST be at least 16 characters
JWT_SECRET=generate-a-secure-random-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Admin (REQUIRED: CHANGE THESE) ---
CREATE_DEFAULT_ADMIN=true
DEFAULT_ADMIN_EMAIL=admin@smarter-ai.app
# MUST be at least 8 characters
DEFAULT_ADMIN_PASSWORD=HariKrishna1@@@
DEFAULT_ADMIN_NAME=Platform Admin

RETIRE_DEFAULT_ADMIN_ACCOUNT=true
RETIRED_ADMIN_EMAIL=admin@example.com

# --- AI & Services ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=smarter-qwen3:4b
OLLAMA_FAST_MODEL=gemma3:1b
OLLAMA_QUALITY_MODEL=smarter-qwen3:4b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_TRANSLATION_MODEL=aya-expanse:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
MODEL_ROUTER_ENABLED=true
MODEL_HEALTH_CACHE_TTL_SECONDS=30
MODEL_UNHEALTHY_COOLDOWN_SECONDS=60
OLLAMA_RELEASE_IDLE_MODELS=false
OLLAMA_IDLE_MODEL_TTL_SECONDS=600
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_THINKING=false
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_MAX_OUTPUT_TOKENS=768
INSTANT_CONTEXT_WINDOW=4096
INSTANT_MAX_OUTPUT_TOKENS=512
AI_REQUEST_TIMEOUT_SECONDS=30
TRANSLATION_CONTEXT_WINDOW=8192
TRANSLATION_REQUEST_TIMEOUT_SECONDS=60
MAX_CHAT_HISTORY_MESSAGES=24
INSTANT_CHAT_HISTORY_MESSAGES=4
MAX_CONTEXT_CHARS=16000
WEB_CONTEXT_TIMEOUT_SECONDS=12
VOICE_ENABLED=true
VOICE_TEMP_DIR=temp_audio
VOICE_STT_MODEL_NAME=openai/whisper-medium
VOICE_STT_DEVICE=auto
VOICE_TTS_PROVIDER=piper
PIPER_MODEL_PATH=models/te-IN-piper.onnx
PIPER_CONFIG_PATH=models/te-IN-piper.json
PIPER_MODEL_PATH_EN=models/en-US-piper.onnx
PIPER_CONFIG_PATH_EN=models/en-US-piper.json
PARLER_TTS_MODEL=ai4bharat/indic-parler-tts-pretrained
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=["*"]
GZIP_MINIMUM_SIZE=1024
AUTO_CREATE_TABLES=true
UPLOAD_DIR=documents/uploads
EXTRACTED_DIR=documents/extracted
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1

# --- Orchestrator & infra (Phase 3) ---
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8080
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql+asyncpg://smarter:smarter@localhost:5432/smarter
QDRANT_URL=http://localhost:6333
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
